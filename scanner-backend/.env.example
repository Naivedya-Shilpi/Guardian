# Port assigned automatically by cloud host (Render, Railway, Heroku) or default to 3000 locally
PORT=3000

# Optional: MongoDB Atlas Connection String
# If left blank or omitted, the backend automatically uses local disk persistence (users.json & latest_scan_report.json)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/guardian?retryWrites=true&w=majority
MONGODB_URI=
